# =================================
# Nutralyze Server — Environment Variables
# =================================
# Copy this file to .env and fill in your values

# --- MongoDB ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nutralyze?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_here

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id_here

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Groq AI ---
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEY_DIETPLAN=optional_separate_key_for_diet_plans

# --- AI Model Server URL (for internal communication) ---
AI_MODEL_URL=http://localhost:5000

# --- CORS (comma-separated, optional) ---
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Port ---
PORT=8080
